{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Worker 名稱，同時決定預設網址 webconf-2026-api.<你的子網域>.workers.dev
  // 跟根目錄 webconf-2026（網站本體）分開部署，互不影響。
  "name": "webconf-2026-api",

  "main": "src/index.ts",
  // 原本寫今天日期（2026-08-23），但本機裝的 wrangler 4.125.0 還不認得這個日期
  // （"in the future and unsupported"）——wrangler 只認得到它發布當下已知的
  // compatibility date，不是真的日曆意義的「未來」。改用根目錄 wrangler.jsonc /
  // nuxt.config.ts 同一個、已驗證能跑的日期，兩邊對齊。
  "compatibility_date": "2026-05-19",

  // 開了才看得到即時 log 與請求量，debug 會用到
  "observability": { "enabled": true },

  // D1 binding，程式裡透過 c.env.DB 存取（見 src/index.ts 的 Bindings 型別）。
  // 目前建在 gui 的 Cloudflare 帳號底下，只是開發用；正式要不要搬到團隊共用帳號還沒定案，
  // 見 backend/README.md「資料庫歸屬」。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webconf-2026-api-db",
      "database_id": "e5230072-16b9-41fe-9bce-bdf028b68be4"
    }
  ],

  // 登入節流用：記錄同一 email 的失敗次數與鎖定狀態（見 Todolist0901-資安.md 2-1）。
  // 用 KV 而不是 D1 是因為天生支援 TTL 自動過期，不用自己寫清除機制。
  // `wrangler dev`（本機）預設會自動用本機模擬的 KV store，不會動到這個正式 namespace。
  "kv_namespaces": [
    {
      "binding": "LOGIN_ATTEMPTS",
      "id": "040b168476eb48d788139334080f6676"
    }
  ]

  // 自訂網域之後再決定要不要接（例如 api.webconf2026.jordanttc.com）。
  // 開發階段先用 workers.dev 預設網址即可，確定要接再打開：
  // "routes": [
  //   { "pattern": "api.webconf2026.jordanttc.com", "custom_domain": true }
  // ]
}
