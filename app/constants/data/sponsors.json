  "sections": [
    {
      "id": "corporate-sponsors",
      "title": "SPONSORS",
      "subtitle": "贊助廠商",
      "description": "WebConf 匯聚來自不同領域的開發者、設計師、產品工作者與產業夥伴。今年，我們將以「Code、Connect、Agent」為主題，從程式技術、社群連結到 AI Agent，探索 Web 技術持續演進下的新機會與可能。誠摯邀請您成為 WebConf 的贊助夥伴，與社群交流、分享實踐，也讓更多參與者認識您的品牌、團隊與正在投入的事。",
      "features": [
        {
          "en": "Programme Sharing",
          "zh": "參與 WebConf 議程或 Keynote 分享機會。"
        },
        {
          "en": "Event Admission",
          "zh": "提供活動入場套票，邀請團隊成員一同參與兩日活動。"
        },
        {
          "en": "On-site Engagement",
          "zh": "設置兩日實體攤位，並可結合大地遊戲與現場互動體驗。"
        },
        {
          "en": "Brand Exposure",
          "zh": "品牌將露出於官網、報名頁、社群及大會相關宣傳素材。"
        },
        {
          "en": "On-site Visibility",
          "zh": "於報到區、主題形象牆、講台、旗幟與立牌等活動場域呈現品牌。"
        }
      ],
      "cta": {
        "label": "成為夥伴",
        "href": "mailto:hi@webconf.tw"
      }
    },
    {
      "id": "passion-sponsor",
      "title": "PASSION SPONSOR",
      "subtitle": "個人贊助",
      "description": "如果你喜歡 WebConf，也希望台灣持續有一個讓技術社群相聚、分享與交流的地方，邀請你以「熱情贊助票」成為支持 WebConf 的一份力量。除了取得活動參與席位，原票價以外的金額將投入 WebConf 的籌辦，支持這場年度聚會持續發生。",
      "features": [
        {
          "en": "Digital Exposure",
          "zh": "可宣傳個人、品牌或專案，與 WebConf 社群分享你正在投入的事。"
        },
        {
          "en": "VIP Seating",
          "zh": "每場講座皆可進入「VIP 席位區」，享有專屬席位。"
        }
