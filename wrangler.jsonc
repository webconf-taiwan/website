{
  "name": "webconf-2013",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "2013.webconf.tw",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".",
    "html_handling": "none"
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
